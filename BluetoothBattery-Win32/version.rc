#include <windows.h>

//
// The app icon Explorer/the taskbar shows for the .exe itself, separate from
// the tray icon BatteryIcon.cs draws at runtime. Same asset as the WinRT
// build's res/app.ico, byte for byte - both builds show the same icon.
//
IDI_APP ICON "res/app.ico"

//
// Version information for Bluetooth Battery, authored rather than generated.
//
// **Why this file exists.** MSBuild generates a version resource from the
// <AssemblyTitle> and <Product> properties in the .csproj, and everything it
// puts in the strings is right, including the UAC prompt's own display name.
// What it will not do is declare a language. Roslyn writes the block key as
// 000004b0 - language-neutral - and there is no MSBuild property that changes
// it. <NeutralLanguage>en-US</NeutralLanguage> sets the managed
// NeutralResourcesLanguageAttribute and leaves the Win32 resource untouched.
//
// So Properties > Details would list the Language as "Language Independent".
// The only way to say English (United States) is to supply the whole
// resource, which is what this is. <Win32Resource> in the .csproj points at
// the compiled .res and MSBuild then generates nothing of its own - which
// means every string below is now the single source of that string,
// including the versions.
//
// InternalName/OriginalFilename say BluetoothBattery, matching the WinRT
// build exactly, since the two never run at the same time and share one
// identity.
//
// **Keep it in step with the .csproj.** AssemblyTitle, Product and FileVersion
// there are still what the managed attributes read; if they disagree with this
// file, Windows shows one and the assembly reports the other.
//
// Language 0x0409 / codepage 1200 is US English / Unicode.
//
//
// The application manifest, embedded here rather than handed to the compiler
// separately.
//
// It has to live in this file: csc takes *either* a Win32 resource file or a
// Win32 manifest, never both (CS1564). Since the version information comes from
// a .res - the only way to declare a language - the manifest comes with it.
// The .csproj does not set <ApplicationManifest>; this line is what puts it in
// the binary. CREATEPROCESS_MANIFEST_RESOURCE_ID is 1, which is the id Windows
// looks for in an executable.
//
// **What it carries matters more here than anywhere else in the suite.** The
// manifest declares per-monitor-v2 DPI awareness - see app.manifest's own
// comment for why that matters here specifically.
//
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Bluetooth Battery"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "BluetoothBattery"
            VALUE "OriginalFilename", "BluetoothBattery.exe"
            VALUE "ProductName",      "Bluetooth Battery"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
